{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['displayName'])",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "$other": {
            ".validate": false
          }
        },
        "settings": {
          ".validate": "newData.hasChildren(['theme', 'compactMode'])",
          "theme": {
            ".validate": "newData.isString() && (newData.val() === 'light' || newData.val() === 'dark' || newData.val() === 'system')"
          },
          "compactMode": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "analysisHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        "$analysisId": {
          ".validate": "newData.hasChildren(['filename', 'rowCount', 'columnCount', 'missingValues', 'status', 'createdAt'])",
          "filename": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
          },
          "rowCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50000"
          },
          "columnCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "missingValues": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000"
          },
          "status": {
            ".validate": "newData.val() === 'completed'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
